    def update_class_dropdown(self):
        conn = sqlite3.connect("academy_attendance.db")
        cursor = conn.cursor()
        cursor.execute("SELECT DISTINCT class_name FROM students")
        rows = cursor.fetchall()
        conn.close()

        classes = sorted([row[0] for row in rows if row[0]])
        self.class_combo['values'] = classes
        if classes:
            self.class_combo.set(classes[0])
            self.update_subject_dropdown()
        else:
            self.class_combo.set('')
            self.subject_combo.set('')
            self.subject_combo['values'] = []
            for widget in self.att_canvas_frame.winfo_children():
                widget.destroy()
            ttk.Label(self.att_canvas_frame, text="No students/classes found. Please add students first.", background="white").pack(padx=10, pady=20)

    def update_subject_dropdown(self):
        selected_class = self.class_combo.get().strip()
        if not selected_class:
            return

        conn = sqlite3.connect("academy_attendance.db")
        cursor = conn.cursor()
        cursor.execute("SELECT subjects FROM students WHERE class_name = ?", (selected_class,))
        rows = cursor.fetchall()
        conn.close()

        all_subjects = set()
        for row in rows:
            subjects_list = [s.strip() for s in row[0].split(",")]
            for sub in subjects_list:
                if sub:
                    all_subjects.add(sub)

        subject_list = sorted(list(all_subjects))
        self.subject_combo['values'] = subject_list
        if subject_list:
            self.subject_combo.set(subject_list[0])
            self.load_attendance_list()
        else:
            self.subject_combo.set('')
            for widget in self.att_canvas_frame.winfo_children():
                widget.destroy()
            ttk.Label(self.att_canvas_frame, text=f"No subjects found for class '{selected_class}'.", background="white").pack(padx=10, pady=20)

    def load_attendance_list(self):
        for widget in self.att_canvas_frame.winfo_children():
            widget.destroy()

        selected_class = self.class_combo.get().strip()
        selected_subject = self.subject_combo.get().strip()
        if not selected_class or not selected_subject:
            return

        conn = sqlite3.connect("academy_attendance.db")
        cursor = conn.cursor()
        cursor.execute("SELECT roll_no, name, subjects FROM students WHERE class_name = ?", (selected_class,))
        students = cursor.fetchall()
        conn.close()

        enrolled_students = []
        for roll_no, name, subjects in students:
            sub_list = [s.strip() for s in subjects.split(",")]
            if selected_subject in sub_list:
                enrolled_students.append((roll_no, name))

        if not enrolled_students:
            ttk.Label(self.att_canvas_frame, text=f"No students in class '{selected_class}' enrolled in '{selected_subject}'.", background="white").pack(padx=10, pady=20)
            return

        self.att_vars = {}
        today = str(date.today())

        conn = sqlite3.connect("academy_attendance.db")
        cursor = conn.cursor()

        for roll_no, name in enrolled_students:
            row_frame = ttk.Frame(self.att_canvas_frame, style="White.TFrame")
            row_frame.pack(fill="x", padx=10, pady=4)

            ttk.Label(row_frame, text=f"{name} ({roll_no})", width=30, anchor="w", background="white").pack(side="left")
            
            cursor.execute("SELECT status FROM attendance WHERE roll_no = ? AND class_name = ? AND subject = ? AND date = ?", 
                           (roll_no, selected_class, selected_subject, today))
            res = cursor.fetchone()
            default_status = res[0] if res else "Present"

            var = tk.StringVar(value=default_status)
            self.att_vars[roll_no] = var

            rb_present = ttk.Radiobutton(row_frame, text="Present", variable=var, value="Present")
            rb_absent = ttk.Radiobutton(row_frame, text="Absent", variable=var, value="Absent")
            
            rb_present.pack(side="left", padx=10)
            rb_absent.pack(side="left", padx=10)

        conn.close()

    def save_attendance(self):
        selected_class = self.class_combo.get().strip()
        selected_subject = self.subject_combo.get().strip()
        
        if not selected_class or not selected_subject:
            messagebox.showerror("Error", "Please select both Class and Subject.")
            return

        if not self.att_vars:
            messagebox.showerror("Error", "No attendance list loaded.")
            return

        today = str(date.today())
        conn = sqlite3.connect("academy_attendance.db")
        cursor = conn.cursor()

        for roll_no, var in self.att_vars.items():
            status = var.get()
            
            cursor.execute("SELECT * FROM attendance WHERE roll_no = ? AND class_name = ? AND subject = ? AND date = ?", 
                           (roll_no, selected_class, selected_subject, today))
            existing = cursor.fetchone()

            if existing:
                cursor.execute("UPDATE attendance SET status = ? WHERE roll_no = ? AND class_name = ? AND subject = ? AND date = ?", 
                               (status, roll_no, selected_class, selected_subject, today))
            else:
                cursor.execute("INSERT INTO attendance (roll_no, class_name, subject, date, status) VALUES (?, ?, ?, ?, ?)", 
                               (roll_no, selected_class, selected_subject, today, status))

        conn.commit()
        conn.close()
        messagebox.showinfo("Success", f"Attendance for Class {selected_class} ({selected_subject}) saved successfully!")

