    def add_student(self):
        name = self.name_entry.get().strip()
        roll_no = self.roll_entry.get().strip()
        class_name = self.class_entry.get().strip()
        subjects = self.subjects_entry.get().strip()

        if not name or not roll_no or not class_name or not subjects:
            messagebox.showerror("Error", "Please fill in all fields (Name, Roll No, Class, Subjects).")
            return

        try:
            conn = sqlite3.connect("academy_attendance.db")
            cursor = conn.cursor()
            cursor.execute("INSERT INTO students (name, roll_no, class_name, subjects) VALUES (?, ?, ?, ?)", 
                           (name, roll_no, class_name, subjects))
            conn.commit()
            conn.close()
            messagebox.showinfo("Success", f"Student {name} added successfully!")
            self.name_entry.delete(0, tk.END)
            self.roll_entry.delete(0, tk.END)
            self.class_entry.delete(0, tk.END)
            self.subjects_entry.delete(0, tk.END)
            self.load_students_list()
        except sqlite3.IntegrityError:
            messagebox.showerror("Error", "Roll number already exists.")

    def delete_selected_student(self):
        selected_item = self.student_tree.selection()
        if not selected_item:
            messagebox.showerror("Error", "Please select a student from the list to delete.")
            return

        item_values = self.student_tree.item(selected_item, "values")
        student_id, name, roll_no, _, _ = item_values

        confirm = messagebox.askyesno(
            "Confirm Deletion",
            f"Are you sure you want to delete student '{name}' (Roll No: {roll_no})?\nThis will also delete their attendance records!"
        )
        if confirm:
            conn = sqlite3.connect("academy_attendance.db")
            cursor = conn.cursor()
            cursor.execute("DELETE FROM attendance WHERE roll_no = ?", (roll_no,))
            cursor.execute("DELETE FROM students WHERE roll_no = ?", (roll_no,))
            conn.commit()
            conn.close()
            self.load_students_list()
            messagebox.showinfo("Success", f"Student {name} deleted successfully.")

    def clear_all_students(self):
        confirm = messagebox.askyesno(
            "Confirm Deletion", 
            "Are you sure you want to delete ALL students?\nThis will also clear all related attendance records and reset IDs to start from 1!"
        )
        if confirm:
            conn = sqlite3.connect("academy_attendance.db")
            cursor = conn.cursor()
            cursor.execute("DELETE FROM attendance")
            cursor.execute("DELETE FROM students")
            cursor.execute("DELETE FROM sqlite_sequence WHERE name='students'")
            conn.commit()
            conn.close()
            self.load_students_list()
            messagebox.showinfo("Success", "All student records have been cleared and IDs have been reset.")

    def load_students_list(self):
        for row in self.student_tree.get_children():
            self.student_tree.delete(row)

        conn = sqlite3.connect("academy_attendance.db")
        cursor = conn.cursor()
        cursor.execute("SELECT id, name, roll_no, class_name, subjects FROM students")
        for row in cursor.fetchall():
            self.student_tree.insert("", tk.END, values=row)
        conn.close()

