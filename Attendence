    def load_report(self):
        for row in self.report_tree.get_children():
            self.report_tree.delete(row)

        filter_roll = self.filter_entry.get().strip()

        conn = sqlite3.connect("academy_attendance.db")
        cursor = conn.cursor()

        if filter_roll:
            cursor.execute("""
                SELECT students.name, students.roll_no, attendance.class_name, attendance.subject, attendance.date, attendance.status 
                FROM attendance 
                JOIN students ON students.roll_no = attendance.roll_no 
                WHERE attendance.roll_no = ?
            """, (filter_roll,))
        else:
            cursor.execute("""
                SELECT students.name, students.roll_no, attendance.class_name, attendance.subject, attendance.date, attendance.status 
                FROM attendance 
                JOIN students ON students.roll_no = attendance.roll_no
            """)

        records = cursor.fetchall()
        conn.close()

        for record in records:
            self.report_tree.insert("", tk.END, values=record)

